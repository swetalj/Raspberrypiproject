        </mxCell>
        <mxCell id="0o4mtUqq8XiZlYujiK5s-2" parent="0o4mtUqq8XiZlYujiK5s-6" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=5;fillColor=#fad9d5;strokeColor=#ae4132;" value="&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;Fan Rule:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;u&lt;sub&gt;2&lt;/sub&gt;(t&lt;sub&gt;k&lt;/sub&gt;)= 1, if T(t&lt;sub&gt;k&lt;/sub&gt;) &amp;gt;30&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0, otherwise&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
